<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- File authoring under development: disabled until TSF actions and rollback exist. -->
  <Package Name="嘸．改" Manufacturer="LiuKai" Version="$(var.MsiVersion)"
           UpgradeCode="7E8341DC-CE5A-4A3A-A6BC-2C5E70FEFC39" Scope="perMachine">
    <Launch Condition="0" Message="This development MSI cannot install until TSF lifecycle and recovery are implemented." />
    <Launch Condition="NOT RollbackDisabled" Message="Windows Installer rollback must be enabled to install or remove 嘸．改." />
    <MajorUpgrade DowngradeErrorMessage="A newer version of 嘸．改 is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Binary Id="UserContext" SourceFile="$(var.UserContextDll)" />
    <Binary Id="LegacyRecovery" SourceFile="$(var.SupportRoot)\recover-legacy-profile.ps1" />
    <Binary Id="LegacyRecoveryPreparedRoot" SourceFile="$(var.SupportRoot)\legacy-prepared-root.ps1" />
    <Binary Id="LegacyRecoveryPolicy" SourceFile="$(var.SupportRoot)\legacy-recovery-policy.ps1" />
    <Binary Id="LegacyRecoveryObserve" SourceFile="$(var.SupportRoot)\legacy-recovery-observe.ps1" />
    <Binary Id="LegacyRecoveryTransaction" SourceFile="$(var.SupportRoot)\legacy-recovery-transaction.ps1" />
    <Binary Id="LegacyRecoveryAdapter" SourceFile="$(var.SupportRoot)\legacy-recovery-adapter.ps1" />
    <Binary Id="LegacyRecoveryBackup" SourceFile="$(var.SupportRoot)\legacy-recovery-backup.ps1" />
    <Binary Id="LegacyRecoveryRegistry" SourceFile="$(var.SupportRoot)\legacy-recovery-registry.ps1" />
    <Binary Id="LegacyRecoveryOwner" SourceFile="$(var.SupportRoot)\legacy-owner-marker.ps1" />
    <Binary Id="LegacyHistoryProbe" SourceFile="$(var.LegacyHistoryProbe)" />
    <Binary Id="FailureDiagnostics" SourceFile="$(var.DiagnosticsScript)" />
    <Property Id="LIUKAIRUNTIMEVERSION" Value="$(var.RuntimeVersion)" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />
    <Property Id="LIUKAIINSTALLTOKEN" Secure="yes"><RegistrySearch Id="FindInstallToken" Root="HKLM" Key="Software\LiuKai\MSI\{7E8341DC-CE5A-4A3A-A6BC-2C5E70FEFC39}" Name="Token" Type="raw" Bitness="always64" /></Property>
    <Property Id="LIUKAIINSTALLSID" Secure="yes"><RegistrySearch Id="FindInstallSid" Root="HKLM" Key="Software\LiuKai\MSI\{7E8341DC-CE5A-4A3A-A6BC-2C5E70FEFC39}" Name="Sid" Type="raw" Bitness="always64" /></Property>
    <CustomAction Id="CaptureUserContext" BinaryRef="UserContext" DllEntry="CaptureUserContext" Execute="immediate" Return="check" />
    <CustomAction Id="ValidateUserContext" BinaryRef="UserContext" DllEntry="ValidateUserContext" Execute="deferred" Impersonate="yes" TerminalServerAware="yes" Return="check" />
    <CustomAction Id="PrepareFreshRegistration" BinaryRef="UserContext" DllEntry="PrepareFreshRegistration" Execute="immediate" Return="check" />
    <CustomAction Id="RecoverLegacyOrphan" BinaryRef="UserContext" DllEntry="RecoverLegacyOrphan" Execute="deferred" Impersonate="yes" TerminalServerAware="yes" Return="check" />
    <CustomAction Id="RegisterFresh" BinaryRef="UserContext" DllEntry="RegisterFresh" Execute="deferred" Impersonate="yes" TerminalServerAware="yes" Return="check" />
    <CustomAction Id="CollectInstallFailure" BinaryRef="UserContext" DllEntry="CollectFailure" Execute="rollback" Impersonate="yes" TerminalServerAware="yes" Return="ignore" />
    <CustomAction Id="CollectRemovalFailure" BinaryRef="UserContext" DllEntry="CollectFailure" Execute="rollback" Impersonate="yes" TerminalServerAware="yes" Return="ignore" />
    <CustomAction Id="RollbackFresh" BinaryRef="UserContext" DllEntry="RollbackFresh" Execute="rollback" Impersonate="yes" TerminalServerAware="yes" Return="check" />
    <CustomAction Id="PrepareRemoval" BinaryRef="UserContext" DllEntry="PrepareRemoval" Execute="immediate" Return="check" />
    <CustomAction Id="RemoveRegistration" BinaryRef="UserContext" DllEntry="RemoveRegistration" Execute="deferred" Impersonate="yes" TerminalServerAware="yes" Return="check" />
    <CustomAction Id="UndoRemoval" BinaryRef="UserContext" DllEntry="UndoRemoval" Execute="rollback" Impersonate="yes" TerminalServerAware="yes" Return="check" />
    <CustomAction Id="UndoRetireFiles" BinaryRef="UserContext" DllEntry="UndoRetireFiles" Execute="rollback" Impersonate="yes" TerminalServerAware="yes" Return="check" />
    <CustomAction Id="RetireFiles" BinaryRef="UserContext" DllEntry="RetireFiles" Execute="deferred" Impersonate="yes" TerminalServerAware="yes" Return="check" />
    <CustomAction Id="CommitRetireFiles" BinaryRef="UserContext" DllEntry="CommitRetireFiles" Execute="commit" Impersonate="yes" TerminalServerAware="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="CaptureUserContext" After="InstallInitialize" Condition="NOT Installed" />
      <Custom Action="PrepareFreshRegistration" After="CaptureUserContext" Condition="NOT Installed" />
      <Custom Action="ValidateUserContext" After="PrepareFreshRegistration" Condition="NOT Installed" />
      <Custom Action="CollectInstallFailure" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="RollbackFresh" After="CollectInstallFailure" Condition="NOT Installed" />
      <Custom Action="RecoverLegacyOrphan" After="RollbackFresh" Condition="NOT Installed" />
      <Custom Action="RegisterFresh" After="RecoverLegacyOrphan" Condition="NOT Installed" />
      <Custom Action="PrepareRemoval" After="InstallInitialize" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="CollectRemovalFailure" Before="UndoRemoval" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UndoRemoval" Before="RemoveRegistration" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="RemoveRegistration" Before="RemoveRegistryValues" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UndoRetireFiles" After="RemoveRegistration" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="RetireFiles" After="UndoRetireFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="CommitRetireFiles" After="RetireFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLROOT" Name="LiuKai">
        <Component Id="InstallIdentity">
          <RegistryValue Root="HKLM" Key="Software\LiuKai\MSI\{7E8341DC-CE5A-4A3A-A6BC-2C5E70FEFC39}" Name="Owner" Value="LiuKai-TSF-v1" Type="string" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="Software\LiuKai\MSI\{7E8341DC-CE5A-4A3A-A6BC-2C5E70FEFC39}" Name="Token" Value="[LIUKAIINSTALLTOKEN]" Type="string" />
          <RegistryValue Root="HKLM" Key="Software\LiuKai\MSI\{7E8341DC-CE5A-4A3A-A6BC-2C5E70FEFC39}" Name="Sid" Value="[LIUKAIINSTALLSID]" Type="string" />
          <RegistryValue Root="HKLM" Key="Software\LiuKai\MSI\{7E8341DC-CE5A-4A3A-A6BC-2C5E70FEFC39}" Name="Version" Value="$(var.RuntimeVersion)" Type="string" />
          <RegistryValue Root="HKLM" Key="Software\LiuKai\MSI\{7E8341DC-CE5A-4A3A-A6BC-2C5E70FEFC39}" Name="ManifestSha256" Value="$(var.ManifestSha256)" Type="string" />
        </Component>
        <Component Id="InstallerCli"><File Id="InstallerCliFile" Source="$(var.PayloadRoot)\LiuKaiInstaller.exe" /></Component>
        <Component Id="RegistrationTool"><File Id="RegistrationToolFile" Source="$(var.RegistrationTool)" /></Component>
        <Directory Id="SUPPORT" Name="support">
          <Component Id="RecoveryMain"><File Source="$(var.SupportRoot)\recover-legacy-profile.ps1" /></Component>
          <Component Id="RecoveryPreparedRoot"><File Source="$(var.SupportRoot)\legacy-prepared-root.ps1" /></Component>
          <Component Id="RecoveryPolicy"><File Source="$(var.SupportRoot)\legacy-recovery-policy.ps1" /></Component>
          <Component Id="RecoveryObserve"><File Source="$(var.SupportRoot)\legacy-recovery-observe.ps1" /></Component>
          <Component Id="RecoveryTransaction"><File Source="$(var.SupportRoot)\legacy-recovery-transaction.ps1" /></Component>
          <Component Id="RecoveryAdapter"><File Source="$(var.SupportRoot)\legacy-recovery-adapter.ps1" /></Component>
          <Component Id="RecoveryBackup"><File Source="$(var.SupportRoot)\legacy-recovery-backup.ps1" /></Component>
          <Component Id="RecoveryRegistry"><File Source="$(var.SupportRoot)\legacy-recovery-registry.ps1" /></Component>
          <Component Id="RecoveryOwner"><File Source="$(var.SupportRoot)\legacy-owner-marker.ps1" /></Component>
          <Component Id="HistoryProbe"><File Source="$(var.LegacyHistoryProbe)" /></Component>
          <Component Id="Diagnostics"><File Source="$(var.DiagnosticsScript)" /></Component>
        </Directory>
        <Directory Id="SHARED" Name="shared">
          <Component Id="Branding"><File Source="$(var.PayloadRoot)\shared\branding.dll" /></Component>
        </Directory>
        <Directory Id="VERSIONS" Name="versions">
          <Directory Id="VERSIONDIR" Name="$(var.RuntimeVersion)">
            <Component Id="PackageManifest"><File Id="PackageManifestFile" Name="package-manifest.json" Source="$(var.PayloadRoot)\manifest.json" /></Component>
            <Directory Id="X64DIR" Name="x64">
              <Component Id="Tsf"><File Id="TsfFile" Source="$(var.RuntimeRoot)\BoshiamyTsf.dll" /></Component>
              <Component Id="Lookup"><File Source="$(var.RuntimeRoot)\LiuKaiLookup.exe" /></Component>
              <Component Id="Settings"><File Source="$(var.RuntimeRoot)\LiuKaiSettings.exe" /></Component>
              <Component Id="Dictionary"><File Source="$(var.RuntimeRoot)\dictionary.tsv" /></Component>
              <Component Id="Readings"><File Source="$(var.RuntimeRoot)\readings.tsv" /></Component>
              <Component Id="RecommendedCodes"><File Source="$(var.RuntimeRoot)\recommended-codes.tsv" /></Component>
              <Component Id="RecommendedSource"><File Source="$(var.RuntimeRoot)\recommended-codes-source.json" /></Component>
              <Component Id="PhoneticCandidates"><File Source="$(var.RuntimeRoot)\phonetic-candidates.tsv" /></Component>
              <Component Id="PhoneticSource"><File Source="$(var.RuntimeRoot)\phonetic-candidates-source.json" /></Component>
              <Component Id="Notices"><File Source="$(var.RuntimeRoot)\THIRD_PARTY_NOTICES.md" /></Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
